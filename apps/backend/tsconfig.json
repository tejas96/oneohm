{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* NestJS-specific overrides */
    "module": "commonjs",
    "target": "ES2021",
    "types": ["node"], // Only Node.js types, no DOM
    "outDir": "./dist",
    "incremental": true,

    /* Relax only what's necessary for TypeORM entities and NestJS decorators */
    "strictPropertyInitialization": false, // TypeORM entities don't initialize in constructor
    "noUnusedLocals": false, // NestJS decorators sometimes create unused parameters
    "noUnusedParameters": false // NestJS decorators use _ prefix pattern
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
