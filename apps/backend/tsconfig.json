{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": "../..",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@oneohm-epc/shared-auth": ["libs/shared-auth/src/index.ts"],
      "@oneohm-epc/shared-types": ["libs/shared-types/src/index.ts"],
      "@oneohm-epc/shared-utils": ["libs/shared-utils/src/index.ts"],
      "@oneohm-epc/shared-theme": ["libs/shared-theme/src/index.ts"],
      "@oneohm-epc/shared-assets": ["libs/shared-assets/src/index.ts"]
    }
  },
  "include": ["../../libs/**/*", "src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
