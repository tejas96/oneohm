# =============================================
# OneOhm EPC Backend - Environment Variables
# =============================================
# Copy this file to .env and fill in the values
# Never commit .env file to version control

# =============================================
# APPLICATION
# =============================================
NODE_ENV=development
BACKEND_PORT=8085
BACKEND_HOST=localhost
BACKEND_API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3001

# =============================================
# DATABASE (PostgreSQL)
# =============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=oneohm_epc
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/oneohm_epc
DATABASE_SSL=false
DATABASE_LOGGING=true
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# =============================================
# JWT AUTHENTICATION
# =============================================
JWT_SECRET=your_jwt_secret_key_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# =============================================
# REDIS (Caching & Sessions)
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# =============================================
# EMAIL / MAIL SERVICE
# =============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@oneohm.com
MAIL_SECURE=false

# =============================================
# FILE STORAGE
# =============================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE=10485760

# AWS S3 / Tigris Storage (if STORAGE_TYPE=s3 or STORAGE_TYPE=tigris)
# S3_ENDPOINT=https://fly.storage.tigris.dev
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your-bucket-name
# PRESIGNED_URL_EXPIRY=3600

# =============================================
# SECURITY & RATE LIMITING
# =============================================
API_KEY=your_api_key_for_external_services
API_KEY_HEADER=X-API-Key
THROTTLE_TTL=60
THROTTLE_LIMIT=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIR=./logs

# =============================================
# FEATURE FLAGS
# =============================================
ENABLE_SWAGGER=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_HELMET=true

# =============================================
# MONITORING & ANALYTICS
# =============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
GA_TRACKING_ID=

# =============================================
# THIRD PARTY INTEGRATIONS
# =============================================
# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Maps / Solar APIs
GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=oneohm-prod
# Prefer a local service-account file for development.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Or use inline credentials in hosted environments.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# =============================================
# INTEGRATIONS (Multi-tenant Architecture)
# =============================================
# Encryption key for storing integration credentials in database
# IMPORTANT: Must be at least 32 characters long
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=your-32-character-secret-key-here-change-in-production

# MSG91 SMS Service (Optional - for development/testing only)
# In production, configure via Admin Integration API per organization
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=YOURAPP
# MSG91_LOGIN_TEMPLATE_ID=your_msg91_login_otp_template_id
# MSG91_PASSWORD_RESET_TEMPLATE_ID=your_msg91_password_reset_otp_template_id

# WhatsApp Business Cloud API
# Runtime prefers these env credentials over DB-stored WhatsApp credentials.
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id
WHATSAPP_API_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# =============================================
# SEED DATA (for npm run seed:*)
# =============================================
PLATFORM_ADMIN_EMAIL=tejas.patil@beyondnyx.com
PLATFORM_ADMIN_PHONE=+918087823247
PLATFORM_ADMIN_PASSWORD=change_me_in_production
SEED_ORG_ID=7e5ce9c8-9c17-4a86-8fcd-da9ce182467b

# =============================================
# MOBILE APP VERSION CONTROL
# =============================================
# Consumer App (com.oneohm.consumer)
CONSUMER_APP_MIN_VERSION=0.1.0
CONSUMER_APP_RECOMMENDED_VERSION=0.1.0
CONSUMER_APP_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.oneohm.consumer
CONSUMER_APP_APP_STORE_URL=https://apps.apple.com/app/oneohm-consumer/id0000000000

# Business App (oneohm)
BUSINESS_APP_MIN_VERSION=1.8.0
BUSINESS_APP_RECOMMENDED_VERSION=1.8.1
BUSINESS_APP_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.oneohm.epc
BUSINESS_APP_APP_STORE_URL=https://apps.apple.com/app/oneohm/id0000000000

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are performing scheduled maintenance. Please try again shortly.
