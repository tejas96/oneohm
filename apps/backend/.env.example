# Application
NODE_ENV=development
BACKEND_PORT=8085
BACKEND_HOST=0.0.0.0
BACKEND_API_PREFIX=/api/v1
BASE_URL=http://localhost:8085
CORS_ORIGIN=http://localhost:3001

# Database (required)
DATABASE_HOST=localhost
DATABASE_PORT=5436
DATABASE_USER=oneohm
DATABASE_PASSWORD=postgres
DATABASE_NAME=oneohm_epc
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# JWT (required — set strong secrets in production)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Features
ENABLE_SWAGGER=true
ENABLE_CACHING=false
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_HELMET=true

# Fly.io: set via `fly secrets set` — never commit real values
# DATABASE_HOST, DATABASE_USER, DATABASE_PASSWORD, DATABASE_NAME, JWT_SECRET, etc.
