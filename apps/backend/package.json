{
  "name": "@oneohm-epc/backend",
  "version": "0.0.1",
  "description": "OneOhm EPC Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typeorm": "ts-node --project tsconfig.json -r tsconfig-paths/register ../../node_modules/typeorm/cli.js -d src/database/ormconfig.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/$npm_config_name",
    "migration:create": "npm run typeorm -- migration:create src/database/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "schema:drop": "npm run typeorm -- schema:drop",
    "schema:sync": "npm run typeorm -- schema:sync",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "seed:inventory": "ts-node -r tsconfig-paths/register src/database/seeds/seed-inventory.ts",
    "seed:all": "npm run seed && npm run seed:inventory",
    "migrate:users-to-iam": "ts-node -r tsconfig-paths/register src/scripts/run-migrate-users-to-iam.ts",
    "seed:platform-admin": "ts-node -r tsconfig-paths/register src/database/seeds/platform-admin.seed.ts",
    "seed:master-data": "ts-node -r tsconfig-paths/register src/database/seeds/master-data.seed.ts",
    "seed:prod": "ts-node -r tsconfig-paths/register src/scripts/run-seeds-prod.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@tejas96/shared": "*",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "express": "5.1.0",
    "firebase-admin": "^13.10.0",
    "handlebars": "^4.7.9",
    "ms": "2.1.3",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  }
}
