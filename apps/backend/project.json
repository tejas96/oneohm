{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["type:app", "scope:backend"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "apps/backend/dist",
        "main": "apps/backend/src/main.ts",
        "tsConfig": "apps/backend/tsconfig.build.json",
        "assets": [],
        "generatePackageJson": true
      },
      "configurations": {
        "production": {
          "optimization": true,
          "sourceMap": false
        },
        "development": {
          "optimization": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/main.ts",
        "cwd": "apps/backend"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/backend/src/**/*.ts",
          "apps/backend/test/**/*.ts",
          "apps/backend/package.json"
        ]
      },
      "configurations": {
        "ci": {
          "maxWarnings": 650
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/backend/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "test:e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}/e2e"],
      "options": {
        "jestConfig": "apps/backend/test/jest-e2e.json",
        "passWithNoTests": true
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"apps/backend/**/*.{ts,tsx,js,jsx,json,css,md}\""
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"apps/backend/**/*.{ts,tsx,js,jsx,json,css,md}\""
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/backend/tsconfig.json"
      }
    },
    "seed:platform-admin": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register src/database/seeds/platform-admin.seed.ts",
        "cwd": "apps/backend"
      }
    },
    "prune-lockfile": {
      "executor": "@nx/js:prune-lockfile",
      "dependsOn": ["build"],
      "options": {
        "projectName": "backend",
        "outputPath": "apps/backend/dist"
      }
    },
    "copy-workspace-modules": {
      "executor": "@nx/js:copy-workspace-modules",
      "dependsOn": ["build"],
      "options": {
        "projectName": "backend",
        "outputPath": "apps/backend/dist"
      }
    },
    "prune-clean": {
      "executor": "nx:run-commands",
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "options": {
        "command": "node apps/backend/scripts/prune-clean.mjs"
      }
    },
    "prune": {
      "executor": "nx:noop",
      "dependsOn": ["prune-clean"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["prune"],
      "options": {
        "command": "flyctl deploy apps/backend --config apps/backend/fly.toml"
      }
    }
  }
}
