{
  "name": "ux",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ux",
  "projectType": "application",
  "tags": ["type:docs", "scope:ux"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx http-server apps/ux -p 3002 -c-1 --cors"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}"],
      "options": {
        "command": "echo 'UX documentation ready for GitHub Pages deployment'"
      }
    }
  }
}
