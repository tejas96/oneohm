{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* TypeScript 6.0+ deprecation warnings */
    "ignoreDeprecations": "6.0",

    /* Next.js-specific overrides */
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,

    /* Type declaration paths */
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "types": ["node", "google.maps"],

    /* Base URL - critical for path resolution */
    "baseUrl": ".",

    /* Next.js plugin */
    "plugins": [
      {
        "name": "next"
      }
    ],

    /* App-specific paths + shared libraries */
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/providers": ["./providers/index.tsx"],
      "@/providers/*": ["./providers/*"],
      "@oneohm-epc/shared": ["../../libs/shared/src/index.ts"],
      "@oneohm-epc/shared/types": ["../../libs/shared/src/types/index.ts"],
      "@oneohm-epc/shared/utils": ["../../libs/shared/src/utils/index.ts"],
      "@oneohm-epc/shared/schemas": ["../../libs/shared/src/schemas/index.ts"],
      "@oneohm-epc/shared/constants": ["../../libs/shared/src/constants/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
