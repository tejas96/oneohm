{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Next.js-specific overrides */
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,

    /* Base URL - critical for path resolution */
    "baseUrl": ".",

    /* Next.js plugin */
    "plugins": [
      {
        "name": "next"
      }
    ],

    /* App-specific paths + shared libraries */
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/providers": ["./providers/index.tsx"],
      "@/providers/*": ["./providers/*"],
      "@oneohm-epc/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@oneohm-epc/shared-types/*": ["../../libs/shared-types/src/*"],
      "@oneohm-epc/shared-utils": ["../../libs/shared-utils/src/index.ts"],
      "@oneohm-epc/shared-utils/*": ["../../libs/shared-utils/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
