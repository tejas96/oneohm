{
  "name": "oneohm-epc",
  "version": "0.0.1",
  "description": "OneOhm EPC Monorepo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "mobile:start": "nx start mobile",
    "mobile:ios": "nx run-ios mobile",
    "mobile:android": "nx run-android mobile",
    "mobile:start:android": "nx run-android mobile && sleep 5 && open -a Terminal \"npm run mobile:start\"",
    "mobile:sync:android": "nx sync-deps mobile",
    "mobile:sync:ios": "nx sync-deps mobile && nx pod-install mobile",
    "mobile:lint": "nx lint mobile",
    "mobile:test": "nx test mobile",
    "mobile:bundle:ios": "nx bundle-ios mobile",
    "mobile:bundle:android": "nx bundle-android mobile",
    "backend:dev": "nx serve backend",
    "backend:build": "nx build backend",
    "backend:start": "nx serve backend --configuration=production",
    "backend:test": "nx test backend",
    "backend:test:e2e": "nx test:e2e backend",
    "backend:lint": "nx lint backend",
    "web:dev": "nx serve web",
    "web:build": "nx build web",
    "web:start": "nx serve web --configuration=production",
    "web:lint": "nx lint web",
    "ux:dev": "nx serve ux",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"libs/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"libs/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint": "nx run-many --target=lint --all",
    "lint:check": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "build": "nx run-many --target=build --all",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint",
    "affected:graph": "nx affected:graph",
    "graph": "nx graph",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist apps/*/build dist .nx",
    "install:all": "npm install",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:clean": "docker compose down -v --rmi all"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nx/eslint": "^22.0.2",
    "@nx/js": "^22.0.2",
    "@nx/nest": "^22.0.2",
    "@nx/next": "^22.0.2",
    "@nx/react": "^22.0.2",
    "@nx/react-native": "^22.0.2",
    "@nx/web": "22.0.2",
    "@nx/webpack": "22.0.2",
    "@nx/workspace": "^22.0.2",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@react-native-community/cli": "~18.0.0",
    "@react-native-community/cli-platform-android": "~18.0.0",
    "@react-native-community/cli-platform-ios": "~18.0.0",
    "@react-native/babel-preset": "~0.79.3",
    "@react-native/metro-config": "~0.79.3",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.6",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "metro-config": "~0.82.4",
    "metro-react-native-babel-preset": "^0.77.0",
    "metro-react-native-babel-transformer": "^0.77.0",
    "metro-resolver": "~0.82.4",
    "nx": "^22.0.2",
    "prettier": "^3.4.2",
    "react-native-svg": "~15.11.2",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-svg-web": "~1.0.9",
    "react-native-web": "~0.20.0",
    "react-refresh": "^0.10.0",
    "tslib": "^2.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.2.1",
    "@react-navigation/native": "^7.0.13",
    "@react-navigation/native-stack": "^7.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "~0.79.3",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.5.0"
  }
}
