              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"profileType\": \"employee\",\n  \"profileData\": {\n    \"employeeId\": \"EMP002\",\n    \"designation\": \"Manager\",\n    \"department\": \"Operations\"\n  }\n}",
