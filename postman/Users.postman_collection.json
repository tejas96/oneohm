    },
    {
      "name": "🛒 Customer Onboarding",
      "item": [
        {
          "name": "Create Customer (Auto-creates User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    console.log('✅ Customer created: ' + jsonData.id);",
                  "    console.log('✅ User auto-created and role assigned');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-organization-id",
                "value": "{{organizationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rajesh\",\n  \"lastName\": \"Kumar\",\n  \"email\": \"rajesh.kumar@gmail.com\",\n  \"phone\": \"+919876543213\",\n  \"address\": \"456 Residential Colony\",\n  \"city\": \"Delhi\",\n  \"state\": \"Delhi\",\n  \"pincode\": \"110001\",\n  \"propertyType\": \"residential\",\n  \"leadSource\": \"website\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            },
            "description": "Create a customer profile.\n\n**Note:** This endpoint automatically:\n1. Creates user if not exists (by phone)\n2. Creates customer profile\n3. Assigns `customer` role"
          },
          "response": []
        }
      ]
    },
