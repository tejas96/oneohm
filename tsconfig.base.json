{
  "compileOnSave": false,
  "compilerOptions": {
    /* Base Options */
    "rootDir": ".",
    "baseUrl": ".",

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    /* Module Resolution */
    "moduleResolution": "node",
    "module": "esnext",
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "importHelpers": true,
    "downlevelIteration": true,

    /* Decorators */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Interop Constraints */
    "forceConsistentCasingInFileNames": true,

    /* Performance */
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    /* Path Mappings - Shared Package */
    "paths": {
      "@oneohm-epc/shared": ["libs/shared/src/index.ts"],
      "@oneohm-epc/shared/types": ["libs/shared/src/types/index.ts"],
      "@oneohm-epc/shared/utils": ["libs/shared/src/utils/index.ts"],
      "@oneohm-epc/shared/schemas": ["libs/shared/src/schemas/index.ts"],
      "@oneohm-epc/shared/constants": ["libs/shared/src/constants/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "build", ".next", "coverage"]
}
